#include <stdio.h>

int main() {
    int arr[100], n, temp;

    printf("=== BUBBLE SORT ALGORITHM ===\n");
    printf("Enter number of elements to sort: ");
    scanf("%d", &n);

    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Outer loop controls number of passes
    for (int i = 0; i < n - 1; i++) {
        // Inner loop does adjacent comparisons
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                // Swap arr[j] and arr[j+1]
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("\nSorted array in ascending order:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
