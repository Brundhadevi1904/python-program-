#include <stdio.h>

int main() {
    float discharge_lps, total_head_m, pump_efficiency_percent;
    float discharge_m3s, hydraulic_power_W, shaft_power_kW;
    float density = 1000.0; // Density of water in kg/m³
    float g = 9.81;        // Acceleration due to gravity in m/s²

    printf("=== CENTRIFUGAL PUMP POWER ESTIMATOR ===\n");
    printf("Enter Pump Discharge (in Liters per second): ");
    scanf("%f", &discharge_lps);

    printf("Enter Total Manometric Head (in meters): ");
    scanf("%f", &total_head_m);

    printf("Enter Expected Pump Efficiency (in %% , e.g., 75): ");
    scanf("%f", &pump_efficiency_percent);

    // Convert discharge from L/s to m³/s
    discharge_m3s = discharge_lps / 1000.0;

    // Fluid Hydraulic Power (P_hyd) = density * g * Q * H
    hydraulic_power_W = density * g * discharge_m3s * total_head_m;

    // Mechanical Shaft Power = Hydraulic Power / Efficiency
    float efficiency_decimal = pump_efficiency_percent / 100.0;
    shaft_power_kW = (hydraulic_power_W / efficiency_decimal) / 1000.0;

    printf("\n=== PUMP PERFORMANCE SUMMARY ===\n");
    printf("Fluid Net Hydraulic Power = %.2f Watts\n", hydraulic_power_W);
    printf("Required Motor Shaft Power = %.2f kW (~%.2f HP)\n", shaft_power_kW, shaft_power_kW * 1.341);

    return 0;
}
