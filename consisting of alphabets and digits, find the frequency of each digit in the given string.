#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    int freq[10] = {0}; // Initialize counts for digits 0-9 to zero
    scanf("%s", s);
    
    for(int i = 0; i < strlen(s); i++) {
        if(s[i] >= '0' && s[i] <= '9') {
            freq[s[i] - '0']++; // Increment the count for the digit found
        }
    }
    
    for(int i = 0; i < 10; i++) {
        printf("%d ", freq[i]);
    }
    return 0;
}
