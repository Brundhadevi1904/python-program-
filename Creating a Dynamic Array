#include <stdio.h>
#include <stdlib.h> // Required for malloc(), calloc(), and free()

int main() {
    int n, *ptr, sum = 0;

    printf("=== DYNAMIC MEMORY ALLOCATION ===\n");
    printf("Enter number of elements for runtime allocation: ");
    scanf("%d", &n);

    // Dynamically allocate memory blocks using malloc
    // ptr holds the base memory address of the block
    ptr = (int*) malloc(n * sizeof(int));

    // Check if memory allocation failed (system out of memory)
    if (ptr == NULL) {
        printf("Error! Memory allocation failed.\n");
        exit(1); 
    }

    printf("Memory successfully allocated at address: %p\n", (void*)ptr);

    printf("Enter elements:\n");
    for (int i = 0; i < n; ++i) {
        scanf("%d", &ptr[i]); // Can be accessed like a standard array
        sum += ptr[i];
    }

    printf("\nSum of entered elements = %d\n", sum);

    // Deallocate and clean up memory to prevent memory leaks
    free(ptr);
    printf("Dynamic memory successfully released back to OS.\n");

    return 0;
}
