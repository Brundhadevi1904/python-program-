#include <stdio.h>

int main() {
    int size = 5;

    for (int i = 1; i <= size; i++) {
        for (int j = 1; j <= size; j++) {
            // Print star if it is a border element
            if (i == 1 || i == size || j == 1 || j == size) {
                printf("*");
            } else {
                printf(" "); // Print space for hollow center
            }
        }
        printf("\n");
    }
    return 0;
}
